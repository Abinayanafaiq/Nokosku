# ================= WAJIB =================
# Database PostgreSQL. Tabel dibuat otomatis di schema "nokos" (tidak mengganggu tabel lain).
DATABASE_URL=postgresql://user:password@host:6432/namadb
# Isi true kalau penyedia database mewajibkan SSL
DATABASE_SSL=false

# API token smscode.gg (Account Settings)
SMSCODE_API_TOKEN=
SMSCODE_BASE_URL=https://api.smscode.gg/v1

# API key Sakupay (dashboard > Integrasi & API). sk_test_... untuk uji coba, sk_live_... untuk uang sungguhan
SAKUPAY_API_KEY=
SAKUPAY_BASE_URL=https://sakupay.site/api/v1
# Siapa yang tanggung fee QRIS: MERCHANT (kamu) / BUYER (pembeli) / kosong = ikut setelan akun Sakupay
SAKUPAY_FEE_BEARER=
# Biasanya kosongkan: secret otomatis tersimpan saat klik "Hubungkan webhook" di /admin
SAKUPAY_WEBHOOK_SECRET=

# Email yang boleh membuka /admin (daftar dulu di website dengan email ini). Pisahkan dengan koma.
ADMIN_EMAILS=

# ================= TOKO =================
SITE_NAME=NokosKu
# Alamat publik website (wajib https untuk webhook Sakupay), contoh https://nokosku.com
SITE_URL=
# Link CS, contoh https://wa.me/6281234567890 atau https://t.me/namakamu
CONTACT_URL=
CONTACT_LABEL=Hubungi CS

DEPOSIT_MIN=10000
DEPOSIT_MAX=5000000
# Markup awal (bisa diubah di /admin/harga)
MARKUP_PERCENT=50
MARKUP_MIN=1000

# ================= SERVER =================
PORT=3000
# Isi true kalau website sudah diakses lewat https (domain + Cloudflare)
COOKIE_SECURE=false
